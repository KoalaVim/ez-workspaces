#!/usr/bin/env bash
#
# ez-workspaces plugin: maps an ez session onto Rex. One Rex session per repo,
# one tab (a Rex "window") per ez session in it, each created on first use.
# Renaming an ez session relabels its tab; deleting it closes the tab.
#
# The bind itself only answers ez: the work happens in `rex-plugin focus`,
# handed back as a post-shell command so it runs in the shell that ran ez and
# its errors land on that terminal rather than in ez's plugin pipe.
#
# Rex resolves label targets case-insensitively and lets two things share a
# label, so labels are only ever looked up here, in --json listings, and every
# command that changes something is given an ID.
#
# Written for the bash 3.2 that macOS ships: no ${x,,}, no empty "${a[@]}".
set -uo pipefail

dbg() {
    [ -n "${EZ_PLUGIN_DEBUG_LOG:-}" ] || return 0
    printf '[rex] %s\n' "$*" >>"$EZ_PLUGIN_DEBUG_LOG"
}

# The ID of the Rex session labelled $1, empty if none. Extra args are global
# rex flags, e.g. --autostart=false.
find_session() {
    local label=$1
    shift
    rex "$@" ls --json 2>/dev/null | jq -r --arg l "$label" '
        first(.sessions[]? | select((.label // "" | ascii_downcase) == ($l | ascii_downcase))
            | .session_id) // empty' 2>/dev/null || true
}

# The ID of the tab labelled $2 in Rex session $1, empty if none. Tabs that
# hold the block in $skip_block are passed over. Extra args as above.
skip_block=
find_window() {
    local sid=$1 label=$2
    shift 2
    rex "$@" window ls -s "$sid" --json 2>/dev/null | jq -r --arg l "$label" --arg b "$skip_block" '
        first(.windows[]?
            | select((.label // "" | ascii_downcase) == ($l | ascii_downcase))
            | select($b == "" or ([.. | .block_id? // empty] | index($b) | not))
            | .window_id) // empty' 2>/dev/null || true
}

if [ "${1-}" = focus ]; then
    set -e
    repo=$2 sess=$3 dir=$4

    # `rex new` and `rex window new` print label: null in their JSON, though
    # the label is set, so matching goes through the listings, not their output.
    sid=$(find_session "$repo")
    if [ -z "$sid" ]; then
        sid=$(rex new "$repo" -c "$dir" --window "$sess" --json | jq -r '.session_id')
    fi
    wid=$(find_window "$sid" "$sess")
    if [ -z "$wid" ]; then
        wid=$(rex window new -s "$sid" "$sess" -c "$dir" --json | jq -r '.window_id')
    fi

    # session.select is an action of the Rex app, which only takes actions from
    # the CLI with Settings > Rex Server > Remote Control on. When ez runs in a
    # Rex popup that closes on exit, REX_EZ_POPUP holds any error on screen.
    if ! err=$(rex ${REX_CLIENT:+-C "$REX_CLIENT"} do session.select session_id="$sid" window_id="$wid" 2>&1 >/dev/null); then
        printf '%s/%s: tab is ready, but could not switch to it: %s\n' "$repo" "$sess" "$err" >&2
        if [ -n "${REX_EZ_POPUP:-}" ]; then
            read -r -n1 -p 'press any key' _ || true
        fi
        exit 1
    fi
    exit 0
fi

# Hook mode: whatever fails below, ez gets exactly one JSON answer, and Rex
# trouble never fails the ez operation.
response='{"success": true}'
trap 'printf "%s\n" "$response"' EXIT

request=$(cat)
if ! command -v rex >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    dbg "rex or jq not on PATH, skipping"
    exit 0
fi

# ez runs plugins by absolute path; resolve anything else against $PWD.
case $0 in
/*) self=$0 ;;
*) self=$PWD/$0 ;;
esac

# One jq call parses the whole request (each jq costs ~20ms, and on_bind is
# on the path of every switch) and also prepares on_bind's answer. @sh
# single-quotes values for eval here and for the user's shell, which may be
# bash, zsh or fish.
vars=$(jq -r --arg self "$self" '
    (.repo.path // "" | rtrimstr("/") | split("/") | last // "") as $repo
    | (.session.name // "") as $sess
    | (.session.path // .repo.path // "") as $dir
    | @sh "hook=\(.hook // "") repo=\($repo) sess=\($sess) dir=\($dir)",
      @sh "old=\(.rename_context.old_name // "") new=\(.rename_context.new_name // "")",
      # keep_cwd: focus moves to the Rex tab, so the shell that ran ez stays put.
      @sh "bind_response=\({success: true,
          post_shell_commands: [[$self, "focus", $repo, $sess, $dir] | @sh],
          accept: true, keep_cwd: true} | tojson)"
    ' <<<"$request" 2>/dev/null) || exit 0
[ -n "$vars" ] && eval "$vars" || exit 0
dbg "hook=$hook repo=$repo session=$sess dir=$dir"

case $hook in
on_bind)
    [ -n "$repo" ] && [ -n "$sess" ] && [ -n "$dir" ] || exit 0
    response=$bind_response
    ;;

on_session_delete)
    # Cleanup must not start a Rex server just to find nothing to clean up.
    # The tab ez is running in is left alone: closing it would kill ez halfway
    # through the delete.
    sid=$(find_session "$repo" --autostart=false)
    [ -n "$sid" ] || exit 0
    skip_block=${REX_BLOCK:-}
    wid=$(find_window "$sid" "$sess" --autostart=false)
    if [ -z "$wid" ]; then
        dbg "no tab for $repo/$sess"
        exit 0
    fi
    dbg "closing tab $wid in $sid"
    rex --autostart=false window close -s "$sid" "$wid" >/dev/null 2>&1 || exit 0
    # Rex keeps a session with no tabs left; focus recreates it when needed.
    left=$(rex --autostart=false window ls -s "$sid" --json 2>/dev/null |
        jq '.windows | length' 2>/dev/null) || exit 0
    if [ "$left" = 0 ]; then
        dbg "killing empty session $sid"
        rex --autostart=false session kill "$sid" >/dev/null 2>&1 || true
    fi
    ;;

on_session_rename)
    # Without this, the next focus would open a second tab under the new name.
    [ -n "$old" ] && [ -n "$new" ] || exit 0
    sid=$(find_session "$repo" --autostart=false)
    [ -n "$sid" ] || exit 0
    wid=$(find_window "$sid" "$old" --autostart=false)
    [ -n "$wid" ] || exit 0
    dbg "relabelling tab $wid: $old -> $new"
    rex --autostart=false window rename -s "$sid" "$wid" "$new" >/dev/null 2>&1 || true
    ;;
esac
